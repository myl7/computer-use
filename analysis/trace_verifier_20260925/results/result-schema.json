{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "three-building-attempt-result/1",
  "type": "object",
  "required": ["protocol_id", "platform", "model", "family", "attempt_id", "attempt_role", "terminal_status", "source_artifacts", "charges", "timings"],
  "properties": {
    "protocol_id": {"const": "three-building-model-extracted-v1"},
    "platform": {"enum": ["android", "desktop", "web"]},
    "model": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "attempt_role": {"enum": ["initial", "repeat"]},
    "terminal_status": {"enum": ["complete", "extraction_failure", "generation_output_budget_failure", "incomplete", "refused", "provider_error", "insufficient_credit", "timeout", "operator_aborted"]},
    "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "path", "sha256"]}},
    "original_tasks": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["seed", "prompt", "prompt_provenance"]}},
    "extractions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["seed", "input", "output", "binding", "type_check", "retry_count", "calls", "elapsed_seconds"]}},
    "initial_program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_program_sha256": {"type": ["string", "null"]},
    "candidate_history": {"type": "array", "minItems": 1},
    "task_results": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["seed", "status"], "properties": {"status": {"enum": ["pass", "fail", "untested"]}}},
    "admission": {"type": ["boolean", "null"]},
    "repair_rounds": {"type": "array"},
    "charges": {"type": "object", "required": ["unit", "price_sheet", "exact", "reused_initial_translation", "reused_initial_builder", "new_extraction", "new_repair", "C", "charge_records"]},
    "timings": {"type": "object", "required": ["total_seconds"]},
    "deployment": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["not_applicable", "not_required_repeat", "skipped_not_admitted", "pending", "reused", "new_30_use", "incomplete"]}}}
  }
}
