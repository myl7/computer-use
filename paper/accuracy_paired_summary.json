  "definitions": {
    "agent_arm": "top-level success of the t21 summary.json (reactive agent replay, no compiled program)",
    "program_arm": "deploy_use.success of the t21 summary.json (same binding served by the compiled program)",
    "paired": "same binding use_index replayed both ways; only_agent/only_program are the McNemar discordant cells",
    "exact_binomial_p": "two-sided exact binomial on the discordant pairs, min(1, 2*P(X <= min(b,c))), X~Bin(b+c, 0.5); null when no discordant pairs",
    "deploy_q": "successes/n of the deploy.json uses (program use-time pass rate, different use sample than t21)",
    "sampling_note": "t21 replays a fresh 30-use sample per family; t16 headline q is measured on the build-time deploy sample; osworld/webarena deploy.json on their own 30-use samples. They measure different use samples; reported side by side, not asserted equal."
